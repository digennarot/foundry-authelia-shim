# ==============================================================================
# Configurazione Ambiente: foundry-authelia-shim
# ==============================================================================

# Porta e interfaccia locale su cui lo shim è in ascolto
PORT=30001
HOST=127.0.0.1

# URL dell'istanza Foundry VTT v14 upstream
UPSTREAM=http://127.0.0.1:30000

# Intestazioni HTTP passate dal reverse proxy (Authelia / Caddy)
HEADER_USERNAME=remote-user
HEADER_GROUPS=remote-groups
GROUPS_SEPARATOR=,

# Nomi dei gruppi SSO per autorizzazioni
ROLE_ADMIN=foundry-admin
ROLE_PLAYER=foundry-player

# Segreto condiviso con Caddy (inviato tramite header X-Shim-Secret)
# Generabile ad esempio con: openssl rand -hex 24
SHIM_SECRET=cambiami_con_un_token_segreto_casuale

# Origine pubblica (URL HTTPS esterno con cui i client raggiungono Foundry)
PUBLIC_ORIGIN=https://foundry.example.com
FORWARDED_PROTO=https

# Abilita/disabilita l'auto-login automatico alla schermata /join
AUTO_LOGIN=true

# Se true, effettua auto-login anche per gli amministratori (default: false,
# così gli admin atterrano sulla schermata di join standard potendo scegliere il personaggio o entrare come GM)
AUTO_LOGIN_ADMIN=false

# Mappatura facoltativa utenti SSO -> Nomi utente Foundry (insensibile a maiuscole/minuscole)
# Sintassi: username_sso=Nome Foundry,sso2=Altro Utente
# USER_MAP=mariorossi=Mario Rossi,giulia=Giulia GM

# Debug log dettagliati (lasciare vuoto in produzione, impostare a 1 per debug)
DEBUG=
