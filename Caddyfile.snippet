# ==============================================================================
# Snippet Caddy per Foundry VTT protetto con Authelia + foundry-authelia-shim
# ==============================================================================

foundry.example.com {
    # 1. Autenticazione Forward Auth tramite Authelia
    forward_auth authelia:9091 {
        uri /api/verify?rd=https://auth.example.com/
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }

    # 2. Reverse proxy verso lo shim Node.js (invece che direttamente a Foundry)
    reverse_proxy 127.0.0.1:30001 {
        # Invia l'header segreto per consentire allo shim di verificare
        # che la richiesta provenga da Caddy e non da connessioni locali non autorizzate
        header_up X-Shim-Secret "IL_TUO_SEGRETO_GENERATO"
    }
}
